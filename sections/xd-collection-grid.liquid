{% comment %}
  Markup copied verbatim from the supplied "collection page.html" (filter bar,
  .filter-box sidebar accordion and the product grid).

  Wired to Shopify natively:
    - sort dropdown  -> collection.sort_options
    - sidebar        -> collection.filters (Search & Discovery app)
    - price slider   -> the price_range filter's min/max params
    - grid           -> paginated collection.products

  Every filter group in the design is rendered from whatever Search & Discovery
  returns - nothing is hard-coded - so adding or reordering a filter in the app
  changes the sidebar with no theme edit. The design uses four different group
  styles, picked per filter:

    price   -> filter.type == 'price_range'          (dual range slider)
    swatch  -> filter.presentation == 'swatch'/'image' (Colors)
    rating  -> param_name contains 'rating'          (star rows)
    link    -> label listed in "Link-style filters"  (Category)
    else    -> checkbox list                         (Player Level, Playing
                                                      Style, Material, Weight)

  The grid keeps the .bestsellers-slider class because main.css hangs the
  bordered card treatment off it (.bestsellers-slider .product-card-image).
{% endcomment %}
{%- liquid
  # Labels typed in the theme editor, normalised for comparison against
  # filter.label. Liquid cannot strip each item of a split, so the separators
  # are normalised before splitting.
  assign link_labels = section.settings.link_style_filters | downcase | replace: ', ', ',' | replace: ' ,', ',' | split: ','
  assign swatch_labels = section.settings.swatch_style_filters | downcase | replace: ', ', ',' | replace: ' ,', ',' | split: ','

  # Colours the design already paints by class in main.css (.color-charcoal
  # etc). Keep in step with that file if a colour is added there.
  assign design_colours = 'charcoal,navy,crimson,ivory' | split: ','
-%}
{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="section-tb-padding96 pt-0">
    <div class="container custom-width">
      <form id="XdFacetForm" method="get" action="{{ collection.url }}">
        <div class="row border-bottom g-0 mb-4">
          <div class="col-md-6 d-flex align-items-center gap-4">
            <div class="filter-title d-flex align-items-center gap-3 heading-font">
              {{ section.settings.filter_label }} <img src="{{ 'filter.svg' | asset_url }}" class="" alt="">
            </div>
            {%- if section.settings.show_sorting -%}
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              <div class="sort-box d-flex align-items-center">
                <label class="heading-font" for="sortBy">{{ section.settings.sort_label }}</label>
                <select class="form-select" name="sort_by" id="sortBy">
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                      {{- option.name | escape -}}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="row">
          <div class="col-lg-3">
            <div class="filter-box">
              <div class="accordion accordion-flush" id="filterAccordion">
                {%- for filter in collection.filters -%}
                  {%- liquid
                    assign panel_id = 'facet-' | append: forloop.index
                    assign label_key = filter.label | downcase | strip
                    assign presentation = filter.presentation | default: 'text'

                    assign style = 'checkbox'
                    if filter.type == 'price_range'
                      assign style = 'price'
                    elsif presentation == 'swatch' or presentation == 'image' or swatch_labels contains label_key
                      assign style = 'swatch'
                    elsif filter.param_name contains 'rating'
                      assign style = 'rating'
                    elsif link_labels contains label_key
                      assign style = 'link'
                    endif
                  -%}
                  <div class="accordion-item">
                    <h2 class="accordion-header">
                      <button class="accordion-button heading-font" type="button" data-bs-toggle="collapse" data-bs-target="#{{ panel_id }}">{{ filter.label | escape }}</button>
                    </h2>
                    <div id="{{ panel_id }}" class="accordion-collapse collapse show" data-bs-parent="#filterAccordion">
                      {%- case style -%}
                        {%- when 'price' -%}
                          <div class="accordion-body">
                            <div class="price-values d-flex justify-content-between mb-2">
                              <span data-xd-price-min>{{ filter.min_value.value | default: 0 | money_without_trailing_zeros }}</span>
                              <span data-xd-price-max>{{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros }}</span>
                            </div>
                            {%- comment -%}
                              Shopify states money in cents; the slider works in
                              whole currency units, so both ends are divided by
                              100 here and multiplied back in the JS label.
                            {%- endcomment -%}
                            <span class="multi-range">
                              <input
                                type="range"
                                min="0"
                                max="{{ filter.range_max | divided_by: 100 }}"
                                value="{{ filter.min_value.value | default: 0 | divided_by: 100 }}"
                                id="lower"
                                name="{{ filter.min_value.param_name }}"
                                data-xd-price
                              >
                              <input
                                type="range"
                                min="0"
                                max="{{ filter.range_max | divided_by: 100 }}"
                                value="{{ filter.max_value.value | default: filter.range_max | divided_by: 100 }}"
                                id="upper"
                                name="{{ filter.max_value.param_name }}"
                                data-xd-price
                              >
                            </span>
                          </div>

                        {%- when 'swatch' -%}
                          {%- comment -%}
                            Colour chips.

                            The design ships an exact class per colour
                            (.color-charcoal, .color-navy, .color-crimson,
                            .color-ivory in main.css), so the value's handle is
                            emitted as a class and those win when they exist.
                            Any colour without a design class falls back to the
                            swatch Shopify serves, and failing that to a neutral
                            chip - so a new colour added in the admin still
                            renders something sensible.
                          {%- endcomment -%}
                          <div class="accordion-body ps-3">
                            <div class="d-flex gap-3 flex-wrap">
                              {%- for value in filter.values -%}
                                {%- liquid
                                  assign input_id = 'xdf-' | append: panel_id | append: '-' | append: forloop.index
                                  assign colour_handle = value.label | handleize
                                  assign colour_class = colour_handle | prepend: 'color-'

                                  # An inline style would outrank the design's
                                  # class, so it is only emitted for colours the
                                  # design does not already paint.
                                  assign chip = ''
                                  unless design_colours contains colour_handle
                                    if value.swatch.image
                                      assign chip_image = value.swatch.image | image_url: width: 100
                                      capture chip
                                        echo 'background-image:url(' | append: chip_image | append: ');background-size:cover;background-position:center;'
                                      endcapture
                                    elsif value.swatch.color
                                      capture chip
                                        echo 'background-color:rgb(' | append: value.swatch.color.rgb | append: ');'
                                      endcapture
                                    endif
                                  endunless
                                -%}
                                <div class="color-option">
                                  <input
                                    type="checkbox"
                                    class="color-checkbox"
                                    id="{{ input_id }}"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value | escape }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  <label
                                    for="{{ input_id }}"
                                    class="fbf-color__opt {{ colour_class }}{% if chip == blank %} fbf-color__opt--blank{% endif %}"
                                    {% if chip != blank %}style="{{ chip }}"{% endif %}
                                    title="{{ value.label | escape }}"
                                  >
                                    <span class="visually-hidden">{{ value.label | escape }} ({{ value.count }})</span>
                                  </label>
                                </div>
                              {%- endfor -%}
                            </div>
                          </div>

                        {%- when 'rating' -%}
                          {%- comment -%}
                            Star rows. The value label from a rating metafield is
                            a number ("4.0"), so it is drawn as full/half/empty
                            stars; if an app returns something non-numeric the
                            label is printed as-is.
                          {%- endcomment -%}
                          <div class="accordion-body ps-3">
                            <div class="product-review">
                              {%- for value in filter.values -%}
                                {%- liquid
                                  assign input_id = 'xdf-' | append: panel_id | append: '-' | append: forloop.index
                                  assign score = value.label | times: 1.0
                                  assign full_stars = score | floor
                                  assign has_half = false
                                  assign fraction = score | minus: full_stars
                                  if fraction >= 0.5
                                    assign has_half = true
                                  endif
                                  assign half_index = full_stars | plus: 1
                                -%}
                                <label class="review-star d-block mb-2{% if value.active %} is-active{% endif %}" for="{{ input_id }}">
                                  <input
                                    type="checkbox"
                                    class="visually-hidden"
                                    id="{{ input_id }}"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value | escape }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  {%- if score > 0 -%}
                                    {%- for i in (1..5) -%}
                                      {%- if i <= full_stars -%}
                                        <i class="fa-solid fa-star" aria-hidden="true"></i>
                                      {%- elsif i == half_index and has_half -%}
                                        <i class="fa-duotone fa-solid fa-star-half" aria-hidden="true"></i>
                                      {%- else -%}
                                        <i class="fa-regular fa-star" aria-hidden="true"></i>
                                      {%- endif -%}
                                    {%- endfor -%}
                                    <strong class="d-inline-block ms-2">{{ section.settings.rating_suffix }}</strong>
                                  {%- else -%}
                                    <strong class="d-inline-block">{{ value.label | escape }}</strong>
                                  {%- endif -%}
                                  {%- if section.settings.show_counts -%}
                                    <span class="ms-1">({{ value.count }})</span>
                                  {%- endif -%}
                                </label>
                              {%- endfor -%}
                            </div>
                          </div>

                        {%- when 'link' -%}
                          {%- comment -%}
                            Plain links with counts, as in the design's Category
                            group. url_to_add / url_to_remove carry the other
                            active filters through, so nothing is lost.
                          {%- endcomment -%}
                          <div class="accordion-body">
                            <ul class="list-unstyled m-0">
                              {%- for value in filter.values -%}
                                <li>
                                  <a
                                    href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                                    class="filter-link d-flex justify-content-between align-items-center w-100{% if value.active %} is-active{% endif %}"
                                    {% if value.active %}aria-current="true"{% endif %}
                                  >
                                    {{ value.label | escape }} <span>{{ value.count }}</span>
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>

                        {%- else -%}
                          <div class="accordion-body ps-3">
                            <ul class="list-unstyled m-0">
                              {%- for value in filter.values -%}
                                {%- assign input_id = 'xdf-' | append: panel_id | append: '-' | append: forloop.index -%}
                                <li{% unless forloop.last %} class="mb-2"{% endunless %}>
                                  <div class="form-check">
                                    <input
                                      class="form-check-input"
                                      type="checkbox"
                                      id="{{ input_id }}"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value | escape }}"
                                      {% if value.active %}checked{% endif %}
                                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                    >
                                    <label class="form-check-label filter-link d-flex justify-content-between align-items-center w-100" for="{{ input_id }}">
                                      {{ value.label | escape }}
                                      {%- if section.settings.show_counts -%}
                                        <span>{{ value.count }}</span>
                                      {%- endif -%}
                                    </label>
                                  </div>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                      {%- endcase -%}
                    </div>
                  </div>
                {%- else -%}
                  <div class="accordion-item">
                    <div class="accordion-body ps-3">
                      <p class="filter-link mb-0">{{ section.settings.no_filters_text }}</p>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>

          <div class="col-lg-9">
            <div class="row g-4 bestsellers-slider">
              {%- for product in collection.products -%}
                <div class="col-md-4">
                  {%- render 'xd-product-card',
                    product: product,
                    style: 'bestsellers',
                    buy_label: section.settings.buy_label,
                    on_dark: false,
                    show_rating: section.settings.show_rating
                  -%}
                </div>
              {%- else -%}
                <div class="col-12">
                  <p class="filter-link">{{ section.settings.empty_text }}</p>
                </div>
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="xd-pager d-flex justify-content-center gap-2 mt-5">
                {%- if paginate.previous -%}
                  <a class="xd-pager__link" href="{{ paginate.previous.url }}" aria-label="{{ section.settings.prev_label | escape }}">{{ section.settings.prev_label }}</a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a class="xd-pager__link" href="{{ part.url }}">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span class="xd-pager__link is-active" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="xd-pager__link">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a class="xd-pager__link" href="{{ paginate.next.url }}" aria-label="{{ section.settings.next_label | escape }}">{{ section.settings.next_label }}</a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          </div>
        </div>
      </form>
    </div>
  </section>
{%- endpaginate -%}

<script>
  // Submit the facet form whenever a filter or the sort order changes.
  (function () {
    var form = document.getElementById('XdFacetForm');
    if (!form) return;

    var lower = form.querySelector('#lower');
    var upper = form.querySelector('#upper');
    var minLabel = form.querySelector('[data-xd-price-min]');
    var maxLabel = form.querySelector('[data-xd-price-max]');
    var moneyFormat = {{ shop.money_format | json }};

    // Renders a whole-currency amount through the shop's own money format, so
    // the label matches the server-rendered price everywhere else on the page.
    function money(amount) {
      return moneyFormat.replace(/\{\{\s*\w+\s*\}\}/, function () {
        return amount.toLocaleString({{ request.locale.iso_code | json }});
      });
    }

    function syncPriceLabels() {
      if (!lower || !upper) return;
      // Keep the handles from crossing over.
      if (Number(lower.value) > Number(upper.value)) {
        lower.value = upper.value;
      }
      if (minLabel) minLabel.textContent = money(Number(lower.value));
      if (maxLabel) maxLabel.textContent = money(Number(upper.value));
    }

    // The price inputs always carry a value, so left untouched they would pin
    // filter.v.price.gte/lte onto every URL. Disable them (so they are not
    // serialised) whenever they still span the full range.
    function syncPriceInputs() {
      if (!lower || !upper) return;
      var untouched = Number(lower.value) <= Number(lower.min) && Number(upper.value) >= Number(upper.max);
      lower.disabled = untouched;
      upper.disabled = untouched;
    }

    // Dragging fires input continuously - only the release should reload.
    form.addEventListener('input', function (event) {
      if (event.target.hasAttribute('data-xd-price')) syncPriceLabels();
    });

    form.addEventListener('submit', syncPriceInputs);
    form.addEventListener('change', function () {
      syncPriceLabels();
      syncPriceInputs();
      form.submit();
    });

    syncPriceLabels();
  })();
</script>

{% schema %}
{
  "name": "XD Collection grid",
  "settings": [
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label",
      "default": "FILTERS BY"
    },
    {
      "type": "checkbox",
      "id": "show_sorting",
      "label": "Show sort dropdown",
      "default": true
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "SORT BY"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 3,
      "max": 36,
      "step": 3,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": true,
      "info": "Requires a product rating metafield (e.g. from a reviews app)"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "paragraph",
      "content": "The sidebar renders whatever filters are enabled in the Search & Discovery app. Colour groups need a swatch (product option or metaobject) to show as chips."
    },
    {
      "type": "text",
      "id": "link_style_filters",
      "label": "Link-style filter groups",
      "default": "Category",
      "info": "Comma-separated filter names shown as plain links with counts instead of checkboxes, e.g. Category, Collection"
    },
    {
      "type": "text",
      "id": "swatch_style_filters",
      "label": "Swatch-style filter groups",
      "default": "Colors",
      "info": "Comma-separated filter names always shown as colour chips, even when Shopify serves no swatch"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show result counts on checkboxes",
      "default": false,
      "info": "Link-style groups always show their count"
    },
    {
      "type": "text",
      "id": "rating_suffix",
      "label": "Rating filter suffix",
      "default": "& Up"
    },
    {
      "type": "text",
      "id": "no_filters_text",
      "label": "Text when no filters exist",
      "default": "No filters available. Add them in the Search & Discovery app."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty collection text",
      "default": "No products found."
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Card button label",
      "default": "BUY NOW"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Pagination previous",
      "default": "\u2190"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Pagination next",
      "default": "\u2192"
    }
  ],
  "presets": [
    {
      "name": "XD Collection grid"
    }
  ]
}
{% endschema %}
