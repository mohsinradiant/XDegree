{% comment %}
  Markup copied verbatim from the supplied index.html.
  Supports the three card treatments used in the design:
    default   -> "New Arrivals" (static bootstrap grid, dark)
    trending  -> "Trending" (swiper, full-bleed image + New Arrival badge)
    bestsellers -> "Bestsellers" (swiper, bordered card, light)
  Slider classes must stay as-is: js/custom.js boots ".trending-slider".
{% endcomment %}
{%- liquid
  assign style = section.settings.card_style
  assign products = section.settings.collection.products

  if section.settings.view_all_link != blank
    assign view_all_url = section.settings.view_all_link
  elsif section.settings.collection != blank
    assign view_all_url = section.settings.collection.url
  else
    assign view_all_url = '#'
  endif
-%}

<section class="section-tb-padding96{% if style != 'bestsellers' %} bg-black{% endif %}">
  <div class="container custom-width">
    <div class="row mb-5">
      <div class="col-md-8">
        <div class="">
          <div class="sub-heading">{{ section.settings.eyebrow }}</div>
          <h3 class="all-heading heading-font {% if style == 'bestsellers' %}text-primary{% else %}text-white{% endif %}">
            {{- section.settings.heading -}}
          </h3>
        </div>
      </div>
      <div class="col-md-4 d-flex align-items-center">
        <div class="d-flex gap-3 align-items-center">
          <p class="mb-0 text-end fs12 {% if style == 'bestsellers' %}text-primary{% else %}text-white-70{% endif %}">
            {{ section.settings.description }}
          </p>
          <a href="{{ view_all_url }}" class="heading-font btn btn-primary sm-btn">
            {{ section.settings.view_all_label }}
            <span class="btn-icon"><img src="{{ 'rt-icon.svg' | asset_url }}" alt=""></span>
          </a>
        </div>
      </div>
    </div>

    {%- if section.settings.layout == 'slider' -%}
      <div class="trending-slider{% if style == 'bestsellers' %} bestsellers-slider{% endif %} swiper">
        <div class="swiper-wrapper">
          {%- for product in products limit: section.settings.products_to_show -%}
            <div class="swiper-slide">
              {%- render 'xd-product-card',
                product: product,
                style: style,
                show_badge: section.settings.show_badges,
                badge_text: section.settings.badge_text
              -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="pagination position-relative swiper-pagination TrendingPagination top-1 mt-5"></div>
      </div>
    {%- else -%}
      <div class="row">
        {%- for product in products limit: section.settings.products_to_show -%}
          <div class="col-md-3">
            {%- render 'xd-product-card',
              product: product,
              style: style,
              show_badge: section.settings.show_badges,
              badge_text: section.settings.badge_text
            -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "XD Product showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "JUST DROPPED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every element optimized dynamically for structural integrity and high-velocity gameplay."
    },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Leave blank to link to the collection above"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Static grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "default", "label": "New Arrivals (dark, white image tile)" },
        { "value": "trending", "label": "Trending (dark, full-bleed image)" },
        { "value": "bestsellers", "label": "Bestsellers (light, bordered)" }
      ],
      "default": "default"
    },
    { "type": "checkbox", "id": "show_badges", "label": "Show badge on cards", "default": false },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "New Arrival" }
  ],
  "presets": [{ "name": "XD Product showcase" }]
}
{% endschema %}
